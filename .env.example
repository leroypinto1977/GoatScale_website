# Email delivery for the contact + project-brief forms.
# Without these, submissions are validated and logged server-side
# (the forms still work in dev) but no email is sent.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives form submissions.
CONTACT_TO=hello@goatscale.com

# Verified sender. Until you verify a domain in Resend you can use
# "Goat Scale <onboarding@resend.dev>".
CONTACT_FROM=Goat Scale <noreply@goatscale.com>
